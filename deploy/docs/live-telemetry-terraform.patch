+No habilita APIs, no crea Scheduler/Eventarc/Cloud Tasks y no guarda valores de
+secretos: viven en Secret Manager. Ver
+[`docs/staging-flag-matrix.md`](../../../docs/staging-flag-matrix.md).
+
+`backend_secret_environment` declara los secretos como referencias
+(`nombre de variable => { secret, version }`, `latest` por defecto) que Cloud Run
+resuelve al arrancar; el valor nunca pasa por Terraform ni por su estado. El
+módulo da a la cuenta del backend `roles/secretmanager.secretAccessor` sobre
+cada secreto referenciado (una asignación aditiva) y rechaza que un mismo
+nombre sea a la vez variable en claro y secreto. Como `ignore_changes` cubre
+sólo la imagen, **todo lo que se añada a mano al servicio (variables o
+secretos) se elimina en el siguiente `apply`**: debe declararse aquí.
 
 `evaluation_results.tf` declara el dataset `evaluation_dataset_id` (por defecto
 `bankai_evaluation`, aparte del dataset de datos de clientes) y la tabla
diff --git a/deploy/terraform/modules/runtime/main.tf b/deploy/terraform/modules/runtime/main.tf
index 1964392..ca90cac 100644
--- a/deploy/terraform/modules/runtime/main.tf
+++ b/deploy/terraform/modules/runtime/main.tf
@@ -104,6 +104,21 @@ resource "google_cloud_run_v2_service" "backend" {
           value = env.value
         }
       }
+
+      # Secret Manager references: the value is resolved by Cloud Run at start
+      # and never passes through Terraform state or configuration.
+      dynamic "env" {
+        for_each = var.backend_secret_environment
+        content {
+          name = env.key
+          value_source {
+            secret_key_ref {
+              secret  = env.value.secret
+              version = env.value.version
+            }
+          }
+        }
+      }
     }
   }
 
@@ -113,13 +128,30 @@ resource "google_cloud_run_v2_service" "backend" {
   }
 
   # CI updates digests via gcloud; Terraform owns env, VPC, IAM, and scaling.
+  # Anything not declared here (plain or secret) is removed on the next apply.
   lifecycle {
     ignore_changes = [
       template[0].containers[0].image,
     ]
+
+    precondition {
+      condition     = length(setintersection(keys(local.backend_env), keys(var.backend_secret_environment))) == 0
+      error_message = "An environment variable cannot be both plain (backend_environment) and a Secret Manager reference (backend_secret_environment)."
+    }
   }
 }
 
+# The backend runs as its own service account, which must be allowed to read
+# each secret it is given. The binding is additive: it never replaces others.
+resource "google_secret_manager_secret_iam_member" "backend_secret_accessor" {
+  for_each = toset([for ref in values(var.backend_secret_environment) : ref.secret])
+
+  project   = var.project_id
+  secret_id = each.value
+  role      = "roles/secretmanager.secretAccessor"
+  member    = "serviceAccount:${google_service_account.backend.email}"
+}
+
 resource "google_cloud_run_v2_job" "pipeline" {
   name     = "${var.name_prefix}-pipeline"
   location = var.region
