[kdd]
# Identifiers only; credentials are discovered through Application Default Credentials.
project = "factored-hackathon"
dataset = "hackathon"
start_timestamp = "2023-01-01T00:00:00+00:00"
end_timestamp = "2024-01-01T00:00:00+00:00"
output_dir = "artifacts/kdd"
maximum_bytes_billed = 2000000000
max_rows = 100000
algorithms = ["apriori", "fpgrowth"]
min_support = 0.01
min_confidence = 0.60
min_lift = 1.10
max_itemset_length = 4
max_categorical_cardinality = 100
