[kdd]
# Identifiers only; credentials are discovered through Application Default Credentials.
project = "factored-hackathon"
dataset = "hackathon"
# Aligns with Phase 1 dispute baseline snapshot (America/Lima period bounds in UTC).
start_timestamp = "2023-06-17T00:00:00+00:00"
end_timestamp = "2026-06-19T00:00:00+00:00"
output_dir = "artifacts/kdd"
# Full-window scans: ~4.4M transactions and ~13.5k Transactions complaints.
maximum_bytes_billed = 50000000000
max_rows = 5000000
# Graph consensus uses Apriori ∩ FP-Growth ∩ Eclat. apriori_hybrid must match Apriori.
algorithms = ["fpgrowth", "eclat", "apriori", "apriori_hybrid"]
min_support = 0.01
min_confidence = 0.40
min_lift = 1.05
max_itemset_length = 4
max_categorical_cardinality = 100
han_redundancy_epsilon = 0.05

# Population policy (code defaults; documented here for operators):
# - complaints are filtered to category = 'Transactions' (Dispute Transaction Support).
# - when target = status, resolution_days and sla_breached are excluded (anti-leakage).
# - category+subcategory co-antecedents are dropped (MultiLevel tautology filter).
# - claimed_amount does not emit NON_NEGATIVE sign filler items.
# - redundant strict-superset antecedents with identical metrics are deduplicated.
# - fpmax runs as diagnostics only and never feeds the graph.
# - no complaint↔transaction join (C6 remains blocked without a canonical key).
# - max_rows must be >= population size in-window to mine without sampling.

[kdd.validation]
# Temporal train/holdout on the full in-window population (no subsample).
enabled = true
holdout_fraction = 0.20
n_folds = 1
max_confidence_delta = 0.10
