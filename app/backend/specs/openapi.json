							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TransactionEvidence"
								}
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "Tenant or ownership denied",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"409": {
						"description": "Transaction unavailable",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"sessionCookie": []
					}
				]
			}
		},
