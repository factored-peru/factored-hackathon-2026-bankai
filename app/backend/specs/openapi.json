{
	"openapi": "3.1.0",
	"info": {
		"title": "Dispute Transaction Support API",
		"version": "0.1.0",
		"description": "Canonical contract for local, tenant-isolated transaction-dispute support. Escalations are mock-only and never submit a bank dispute."
	},
	"servers": [
		{
			"url": "http://localhost:3000",
			"description": "Development"
		}
	],
	"tags": [
		{
			"name": "health"
		},
		{
			"name": "disputes"
		},
		{
			"name": "conversations"
		},
		{
			"name": "admin"
		}
	],
	"paths": {
		"/openapi.json": {
			"get": {
				"operationId": "getOpenApiSpec",
				"tags": ["health"],
				"summary": "Get canonical OpenAPI spec",
				"responses": {
					"200": {
						"description": "OpenAPI document",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/asyncapi.json": {
			"get": {
				"operationId": "getAsyncApiSpec",
				"tags": ["health"],
				"summary": "Get canonical AsyncAPI realtime contract",
				"responses": {
					"200": {
						"description": "AsyncAPI document",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/v1/health/live": {
			"get": {
				"operationId": "getLiveHealth",
				"tags": ["health"],
				"summary": "Liveness probe",
				"responses": {
					"200": {
						"description": "Process is alive",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthResponse"
								},
								"examples": {
									"ok": {
										"value": {
											"status": "ok",
											"service": "base-bun-typescript-service"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/v1/health/ready": {
			"get": {
				"operationId": "getReadiness",
