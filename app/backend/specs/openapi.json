		"/v1/admin/kg/current": {
			"get": {
				"operationId": "getAdminKgCurrent",
				"tags": ["admin"],
				"summary": "Get the current published KG pointer for the session tenant",
				"description": "Backoffice-only. Returns current.json for the configured local publication root. Payload for P0-16/Harumi without Next scaffold.",
				"security": [
					{
						"sessionCookie": []
					}
				],
