	"components": {
		"headers": {
			"ErrorCodeHeader": {
				"description": "Stable error code. Matches problem.code.",
				"schema": {
					"type": "string",
					"pattern": "^SVC-[A-Z]{3,4}-[0-9]{4}$"
				}
			}
		},
		"securitySchemes": {
			"serviceToken": {
				"type": "http",
				"scheme": "bearer",
				"description": "Optional service-to-service token. Required on protected routes when SERVICE_TOKEN is configured."
			},
			"sessionCookie": {
				"type": "apiKey",
				"in": "cookie",
				"name": "bankai-demo-session",
				"description": "Opaque browser session. Local demo creates it through POST /v1/demo/sessions."
			}
		},
		"schemas": {
			"Problem": {
				"type": "object",
				"required": [
					"type",
					"title",
					"status",
					"code",
					"category",
					"detail_key",
					"behavior",
					"correlation",
					"occurred_at"
				],
				"properties": {
					"type": {
						"type": "string",
						"format": "uri"
					},
					"title": {
						"type": "string"
					},
					"status": {
						"type": "integer",
						"minimum": 400,
						"maximum": 599
					},
					"code": {
						"type": "string",
						"pattern": "^SVC-[A-Z]{3,4}-[0-9]{4}$"
					},
					"category": {
						"enum": [
							"VALIDATION",
							"AUTHN_AUTHZ",
							"DECISION_DENY",
							"STATE_CONFLICT",
							"DEPENDENCY",
							"INDETERMINATE",
							"INTERNAL"
						]
					},
					"detail_key": {
						"type": "string"
					},
					"behavior": {
						"$ref": "#/components/schemas/ErrorBehavior"
					},
					"correlation": {
						"$ref": "#/components/schemas/ErrorCorrelation"
					},
					"occurred_at": {
						"type": "string",
						"format": "date-time"
					}
				},
				"additionalProperties": false
			},
			"DemoActor": {
				"type": "object",
				"required": ["actorId", "label", "role", "recommended"],
				"properties": {
					"actorId": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"role": {
						"enum": ["customer", "backoffice"]
					},
					"recommended": {
						"type": "boolean"
					}
				},
				"additionalProperties": false
			},
			"DemoSession": {
				"type": "object",
				"required": ["status", "role"],
				"properties": {
					"status": {
						"const": "created"
					},
					"role": {
						"enum": ["customer", "backoffice"]
					}
				},
				"additionalProperties": false
			},
			"DemoFixtures": {
				"type": "object",
				"required": ["transactionId", "disputeId", "caseId"],
				"properties": {
					"transactionId": {
						"const": "demo-transaction-1"
					},
					"disputeId": {
						"const": "demo-dispute-1"
					},
					"caseId": {
						"const": "demo-case-1"
					}
				},
				"additionalProperties": false
			},
			"SafeSession": {
				"type": "object",
				"required": [
					"userId",
					"tenantId",
					"roles",
					"capabilities",
					"sessionVersion"
				],
				"properties": {
					"userId": {
						"type": "string"
					},
					"tenantId": {
						"type": "string"
					},
					"roles": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"capabilities": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"sessionVersion": {
						"type": "integer"
					}
				},
				"additionalProperties": false
			},
			"Attachment": {
				"type": "object",
				"required": ["attachmentId", "kind", "mediaType", "status"],
				"properties": {
					"attachmentId": {
						"type": "string"
					},
					"kind": {
						"enum": ["image", "audio"]
					},
					"mediaType": {
						"type": "string"
					},
					"status": {
						"enum": ["pending_upload", "pending_review", "ready", "rejected"]
					}
				},
				"additionalProperties": false
			},
			"UploadAuthorization": {
				"type": "object",
				"required": ["attachment", "uploadUrl"],
				"properties": {
					"attachment": {
						"$ref": "#/components/schemas/Attachment"
					},
					"uploadUrl": {
						"type": "string"
					}
				},
				"additionalProperties": false
			},
			"CreateUploadRequest": {
				"type": "object",
				"required": ["kind", "mediaType", "byteSize", "filename"],
				"properties": {
					"kind": {
						"enum": ["image", "audio"]
					},
					"mediaType": {
						"type": "string",
						"minLength": 1
					},
					"byteSize": {
						"type": "integer",
						"minimum": 1,
						"maximum": 10485760
					},
					"filename": {
						"type": "string",
						"minLength": 1
					}
				},
				"additionalProperties": false
			},
			"ConversationSnapshot": {
				"type": "object",
				"required": [
					"threadId",
					"tenantId",
					"ownerUserId",
					"revision",
					"messages",
					"trace"
				],
				"properties": {
					"threadId": {
						"type": "string"
					},
					"tenantId": {
						"type": "string"
					},
					"ownerUserId": {
						"type": "string"
					},
					"revision": {
						"type": "integer"
					},
					"messages": {
						"type": "array",
						"items": {
							"type": "object"
						}
					},
					"trace": {
						"type": "object"
					}
				},
				"additionalProperties": false
			},
			"ErrorBehavior": {
				"type": "object",
				"required": [
					"retryable",
					"financial_effect",
					"human_action",
					"agent_hint",
					"retry_after_s"
				],
				"properties": {
					"retryable": {
						"enum": [
							"never",
							"safe_if_idempotent",
							"conditional",
							"after_reconcile"
						]
					},
					"financial_effect": {
						"enum": ["none", "unknown", "possible_partial"]
					},
					"human_action": {
						"enum": ["none", "approve", "step_up", "contact_support"]
					},
					"agent_hint": {
						"enum": [
							"NONE",
							"FIX_AND_RETRY",
							"RETRY_WITH_BACKOFF",
							"REQUEST_HUMAN_APPROVAL",
							"REQUEST_STEP_UP",
							"WAIT_FOR_SETTLEMENT",
							"ABORT_AND_REPORT"
						]
					},
					"retry_after_s": {
						"type": ["integer", "null"],
						"minimum": 0
					}
				},
				"additionalProperties": false
			},
			"ErrorCorrelation": {
				"type": "object",
				"required": ["trace_id"],
				"properties": {
					"trace_id": {
						"type": "string"
					}
				},
				"additionalProperties": false
			},
			"HealthResponse": {
				"type": "object",
				"required": ["status", "service"],
				"properties": {
					"status": {
						"const": "ok"
					},
					"service": {
						"type": "string"
					}
				},
				"additionalProperties": false
			},
			"SessionCreated": {
				"type": "object",
				"required": ["status"],
				"properties": {
					"status": {
						"const": "created"
					}
				},
				"additionalProperties": false
			},
			"TransactionEvidence": {
				"type": "object",
				"required": [
					"transactionId",
					"status",
					"amountBucket",
					"currency",
					"provenance",
					"version"
				],
				"properties": {
					"transactionId": {
						"type": "string"
					},
					"status": {
						"enum": ["approved", "declined", "pending", "reversed"]
					},
					"amountBucket": {
						"enum": ["low", "medium", "high"]
					},
					"currency": {
						"type": "string",
						"minLength": 3,
						"maxLength": 3
					},
					"provenance": {
						"const": "synthetic_local_fixture"
					},
					"version": {
						"const": "dispute-demo-v1"
					}
				},
				"additionalProperties": false
			},
			"DisputeEvidence": {
				"type": "object",
				"required": [
					"disputeId",
					"transactionId",
					"status",
					"priority",
					"provenance",
					"version"
				],
				"properties": {
					"disputeId": {
						"type": "string"
					},
					"transactionId": {
						"type": "string"
					},
					"status": {
						"enum": ["open", "under_review", "escalated", "closed"]
					},
					"priority": {
						"enum": ["normal", "high"]
					},
					"provenance": {
						"const": "synthetic_local_fixture"
					},
					"version": {
						"const": "dispute-demo-v1"
					}
				},
				"additionalProperties": false
			},
			"DisputeCase": {
				"type": "object",
				"required": [
					"caseId",
					"disputeId",
					"status",
					"createdAt",
					"updatedAt",
					"provenance",
					"version"
				],
				"properties": {
					"caseId": {
						"type": "string"
					},
					"disputeId": {
						"type": "string"
					},
					"status": {
						"enum": ["open", "pending_approval", "escalated", "denied"]
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"provenance": {
						"const": "synthetic_local_fixture"
					},
					"version": {
						"const": "dispute-demo-v1"
					}
				},
				"additionalProperties": false
			},
			"EscalationRequest": {
				"type": "object",
				"required": ["reasonCode"],
				"properties": {
					"reasonCode": {
						"enum": [
							"unrecognized_transaction",
							"transaction_declined",
							"other"
						]
					}
				},
				"additionalProperties": false
			},
			"ApprovalDecision": {
				"type": "object",
				"required": ["decision"],
				"properties": {
					"decision": {
						"enum": ["approved", "rejected"]
					}
				},
				"additionalProperties": false
			},
			"PendingEscalation": {
				"type": "object",
				"required": ["approvalId", "case"],
				"properties": {
					"approvalId": {
						"type": "string"
					},
					"case": {
						"type": "object"
					}
				},
				"additionalProperties": false
			},
			"MockEscalationDecision": {
				"type": "object",
				"required": ["case", "action"],
				"properties": {
					"case": {
						"type": "object"
					},
					"action": {
						"type": ["object", "null"]
					}
				},
				"additionalProperties": false
			},
			"ReadinessResponse": {
				"type": "object",
				"required": ["status", "service", "details"],
				"properties": {
					"status": {
						"enum": ["ok", "degraded"]
					},
					"service": {
						"type": "string"
					},
					"details": {
						"type": "object",
						"additionalProperties": true
					}
				},
				"additionalProperties": false
			},
			"KgCurrentPointer": {
				"type": "object",
				"required": [
					"schema_version",
					"tenant_id",
					"run_id",
					"catalog_version",
					"artifact_dir",
					"files",
					"provenance"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"const": "bankai-local-kg-publication-v1"
					},
					"tenant_id": {
						"type": "string",
						"minLength": 1
					},
					"run_id": {
						"type": "string",
						"minLength": 3
					},
					"catalog_version": {
						"type": "string",
						"minLength": 1
					},
					"artifact_dir": {
						"type": "string",
						"minLength": 3
					},
					"files": {
						"type": "object",
						"required": [
							"graph-v1.msgpack",
							"graph-manifest.json",
							"kg-operation-catalog.json"
						],
						"properties": {
							"graph-v1.msgpack": {
								"type": "string",
								"pattern": "^[a-f0-9]{64}$"
							},
							"graph-manifest.json": {
								"type": "string",
								"pattern": "^[a-f0-9]{64}$"
							},
							"kg-operation-catalog.json": {
