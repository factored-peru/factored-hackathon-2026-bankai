{
	"openapi": "3.1.0",
	"info": {
		"title": "Dispute Transaction Support API",
		"version": "0.1.0",
		"description": "Canonical contract for local, tenant-isolated transaction-dispute support. Escalations are mock-only and never submit a bank dispute."
	},
	"servers": [
		{
			"url": "http://localhost:3000",
			"description": "Development"
		}
	],
	"tags": [
		{
			"name": "health"
		},
		{
			"name": "items"
		},
		{
			"name": "disputes"
		},
		{
			"name": "conversations"
		}
	],
	"paths": {
		"/openapi.json": {
			"get": {
				"operationId": "getOpenApiSpec",
				"tags": ["health"],
				"summary": "Get canonical OpenAPI spec",
				"responses": {
					"200": {
						"description": "OpenAPI document",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/asyncapi.json": {
			"get": {
				"operationId": "getAsyncApiSpec",
				"tags": ["health"],
				"summary": "Get canonical AsyncAPI realtime contract",
				"responses": {
					"200": {
						"description": "AsyncAPI document",
						"content": {
							"application/json": { "schema": { "type": "object" } }
						}
					}
				}
			}
		},
		"/v1/health/live": {
			"get": {
				"operationId": "getLiveHealth",
				"tags": ["health"],
				"summary": "Liveness probe",
				"responses": {
					"200": {
						"description": "Process is alive",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthResponse"
								},
								"examples": {
									"ok": {
										"value": {
											"status": "ok",
											"service": "base-bun-typescript-service"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/v1/health/ready": {
			"get": {
				"operationId": "getReadiness",
				"tags": ["health"],
				"summary": "Readiness probe",
				"responses": {
					"200": {
						"description": "Readiness state",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReadinessResponse"
								}
							}
						}
					}
				}
			}
		},
		"/v1/items": {
			"post": {
				"operationId": "createItem",
				"tags": ["items"],
				"summary": "Create an item",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateItemRequest"
							},
							"examples": {
								"demo": {
									"value": {
										"name": "demo",
										"metadata": {}
									}
								}
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created item",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Item"
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid service token",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"422": {
						"description": "Invalid request",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"serviceToken": []
					}
				]
			}
		},
		"/v1/items/{itemId}": {
			"get": {
				"operationId": "getItem",
				"tags": ["items"],
				"summary": "Get an item",
				"parameters": [
					{
						"name": "itemId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Item",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Item"
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid service token",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"409": {
						"description": "Resource state conflict",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"serviceToken": []
					}
				]
			}
		},
		"/v1/sessions": {
			"post": {
				"operationId": "createDisputeSession",
				"tags": ["disputes"],
				"summary": "Verify an identity token and set an opaque session cookie",
				"responses": {
					"201": {
						"description": "Session created",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SessionCreated" }
							}
						}
					},
					"401": {
						"description": "Missing or invalid identity token",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"502": {
						"description": "Identity runtime unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				}
			}
		},
		"/v1/transactions/{transactionId}": {
			"get": {
				"operationId": "getTransactionEvidence",
				"tags": ["disputes"],
				"summary": "Get authorized transaction evidence",
				"parameters": [
					{
						"name": "transactionId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Synthetic local evidence",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/TransactionEvidence" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"403": {
						"description": "Tenant or ownership denied",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Transaction unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/disputes/{disputeId}": {
			"get": {
				"operationId": "getDisputeEvidence",
				"tags": ["disputes"],
				"summary": "Get authorized dispute evidence",
				"parameters": [
					{
						"name": "disputeId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Synthetic local evidence",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/DisputeEvidence" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"403": {
						"description": "Tenant or ownership denied",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Dispute unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/dispute-cases/{caseId}/escalations": {
			"post": {
				"operationId": "requestMockEscalation",
				"tags": ["disputes"],
				"summary": "Request a mock escalation; it requires an operator decision",
				"parameters": [
					{
						"name": "caseId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/EscalationRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Pending approval",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/PendingEscalation" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"403": {
						"description": "Capability or ownership denied",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Case state conflict",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/dispute-cases/{caseId}": {
			"get": {
				"operationId": "getDisputeCase",
				"tags": ["disputes"],
				"summary": "Get an authorized synthetic dispute case",
				"parameters": [
					{
						"name": "caseId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Case evidence",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/DisputeCase" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"403": {
						"description": "Tenant or ownership denied",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Case unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/approvals/{approvalId}/decisions": {
			"post": {
				"operationId": "decideMockEscalation",
				"tags": ["disputes"],
				"summary": "Approve or reject a mock escalation as an operator",
				"parameters": [
					{
						"name": "approvalId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/ApprovalDecision" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Decision recorded",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/MockEscalationDecision"
								}
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"403": {
						"description": "Operator capability denied",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Approval state conflict",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/demo/actors": {
			"get": {
				"operationId": "listDemoActors",
				"tags": ["conversations"],
				"summary": "List safe demo actor aliases",
				"responses": {
					"200": {
						"description": "Demo actor aliases",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": { "$ref": "#/components/schemas/DemoActor" }
								}
							}
						}
					},
					"502": {
						"description": "Demo mode unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				}
			}
		},
		"/v1/demo/fixtures": {
			"get": {
				"operationId": "getDemoFixtures",
				"tags": ["conversations", "disputes"],
				"summary": "Get IDs of the synthetic in-memory demo fixture",
				"responses": {
					"200": {
						"description": "Safe fixture identifiers",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/DemoFixtures" }
							}
						}
					},
					"502": {
						"description": "Demo mode unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				}
			}
		},
		"/v1/demo/sessions": {
			"post": {
				"operationId": "createDemoSession",
				"tags": ["conversations"],
				"summary": "Create a mock customer or backoffice session",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["actorId"],
								"properties": { "actorId": { "type": "string" } },
								"additionalProperties": false
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Opaque session cookie created",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/DemoSession" }
							}
						}
					},
					"401": {
						"description": "Unknown demo actor",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"502": {
						"description": "Demo mode unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				}
			}
		},
		"/v1/me": {
			"get": {
				"operationId": "getCurrentSession",
				"tags": ["conversations"],
				"summary": "Get safe current session context",
				"responses": {
					"200": {
						"description": "Safe session",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SafeSession" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/conversations": {
			"get": {
				"operationId": "listConversations",
				"tags": ["conversations"],
				"summary": "List authorized sanitized conversation snapshots",
				"responses": {
					"200": {
						"description": "Snapshots",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/ConversationSnapshot"
									}
								}
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/conversations/{threadId}": {
			"get": {
				"operationId": "getConversation",
				"tags": ["conversations"],
				"summary": "Get an authorized sanitized conversation snapshot",
				"parameters": [
					{
						"name": "threadId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Snapshot",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ConversationSnapshot"
								}
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Conversation unavailable or unauthorized",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/uploads": {
			"post": {
				"operationId": "createConversationUpload",
				"tags": ["conversations"],
				"summary": "Create a controlled image or audio upload",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateUploadRequest" },
							"examples": {
								"image": {
									"value": {
										"kind": "image",
										"mediaType": "image/png",
										"byteSize": 3,
										"filename": "receipt.png"
									}
								}
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Upload authorization",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UploadAuthorization" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"422": {
						"description": "Invalid attachment",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/demo/uploads/{attachmentId}": {
			"put": {
				"operationId": "uploadDemoAttachment",
				"tags": ["conversations"],
				"summary": "Upload attachment bytes to the local in-memory demo",
				"parameters": [
					{
						"name": "attachmentId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"image/png": { "schema": { "type": "string", "format": "binary" } },
						"image/jpeg": {
							"schema": { "type": "string", "format": "binary" }
						},
						"audio/mpeg": {
							"schema": { "type": "string", "format": "binary" }
						},
						"audio/wav": { "schema": { "type": "string", "format": "binary" } }
					}
				},
				"responses": {
					"200": {
						"description": "Bytes accepted",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Attachment" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Attachment ownership, type, size or state conflict",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		},
		"/v1/uploads/{attachmentId}/complete": {
			"post": {
				"operationId": "completeConversationUpload",
				"tags": ["conversations"],
				"summary": "Validate a completed controlled upload",
				"parameters": [
					{
						"name": "attachmentId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Validated attachment",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Attachment" }
							}
						}
					},
					"401": {
						"description": "Session missing or expired",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					},
					"409": {
						"description": "Attachment unavailable",
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/Problem" }
							}
						}
					}
				},
				"security": [{ "sessionCookie": [] }]
			}
		}
	},
	"components": {
		"headers": {
			"ErrorCodeHeader": {
				"description": "Stable error code. Matches problem.code.",
				"schema": {
					"type": "string",
					"pattern": "^SVC-[A-Z]{3,4}-[0-9]{4}$"
				}
			}
		},
		"securitySchemes": {
			"serviceToken": {
				"type": "http",
				"scheme": "bearer",
				"description": "Optional service-to-service token. Required on protected routes when SERVICE_TOKEN is configured."
			},
			"sessionCookie": {
				"type": "apiKey",
				"in": "cookie",
				"name": "bankai-demo-session",
				"description": "Opaque browser session. Local demo creates it through POST /v1/demo/sessions."
			}
		},
		"schemas": {
			"Problem": {
				"type": "object",
				"required": [
					"type",
					"title",
					"status",
					"code",
					"category",
					"detail_key",
					"behavior",
					"correlation",
					"occurred_at"
				],
				"properties": {
					"type": {
						"type": "string",
						"format": "uri"
					},
					"title": {
						"type": "string"
					},
					"status": {
						"type": "integer",
						"minimum": 400,
						"maximum": 599
					},
					"code": {
						"type": "string",
						"pattern": "^SVC-[A-Z]{3,4}-[0-9]{4}$"
					},
					"category": {
						"enum": [
							"VALIDATION",
							"AUTHN_AUTHZ",
							"DECISION_DENY",
							"STATE_CONFLICT",
							"DEPENDENCY",
							"INDETERMINATE",
							"INTERNAL"
						]
					},
					"detail_key": {
						"type": "string"
					},
					"behavior": {
						"$ref": "#/components/schemas/ErrorBehavior"
					},
					"correlation": {
						"$ref": "#/components/schemas/ErrorCorrelation"
					},
					"occurred_at": {
						"type": "string",
						"format": "date-time"
					}
				},
				"additionalProperties": false
			},
			"CreateItemRequest": {
				"type": "object",
				"required": ["name"],
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 120
					},
					"metadata": {
						"type": "object",
						"additionalProperties": true,
						"default": {}
					}
				},
				"additionalProperties": false
			},
			"DemoActor": {
				"type": "object",
				"required": ["actorId", "label", "role", "recommended"],
				"properties": {
					"actorId": { "type": "string" },
					"label": { "type": "string" },
					"role": { "enum": ["customer", "backoffice"] },
					"recommended": { "type": "boolean" }
				},
				"additionalProperties": false
			},
			"DemoSession": {
				"type": "object",
				"required": ["status", "role"],
				"properties": {
					"status": { "const": "created" },
					"role": { "enum": ["customer", "backoffice"] }
				},
				"additionalProperties": false
			},
			"DemoFixtures": {
				"type": "object",
				"required": ["transactionId", "disputeId", "caseId"],
				"properties": {
					"transactionId": { "const": "demo-transaction-1" },
					"disputeId": { "const": "demo-dispute-1" },
					"caseId": { "const": "demo-case-1" }
				},
				"additionalProperties": false
			},
			"SafeSession": {
				"type": "object",
				"required": [
					"userId",
					"tenantId",
					"roles",
					"capabilities",
					"sessionVersion"
				],
				"properties": {
					"userId": { "type": "string" },
					"tenantId": { "type": "string" },
					"roles": { "type": "array", "items": { "type": "string" } },
					"capabilities": { "type": "array", "items": { "type": "string" } },
					"sessionVersion": { "type": "integer" }
				},
				"additionalProperties": false
			},
			"Attachment": {
				"type": "object",
				"required": ["attachmentId", "kind", "mediaType", "status"],
				"properties": {
					"attachmentId": { "type": "string" },
					"kind": { "enum": ["image", "audio"] },
					"mediaType": { "type": "string" },
					"status": {
						"enum": ["pending_upload", "pending_review", "ready", "rejected"]
					}
				},
				"additionalProperties": false
			},
			"UploadAuthorization": {
				"type": "object",
				"required": ["attachment", "uploadUrl"],
				"properties": {
					"attachment": { "$ref": "#/components/schemas/Attachment" },
					"uploadUrl": { "type": "string" }
				},
				"additionalProperties": false
			},
			"CreateUploadRequest": {
				"type": "object",
				"required": ["kind", "mediaType", "byteSize", "filename"],
				"properties": {
					"kind": { "enum": ["image", "audio"] },
					"mediaType": { "type": "string", "minLength": 1 },
					"byteSize": { "type": "integer", "minimum": 1, "maximum": 10485760 },
					"filename": { "type": "string", "minLength": 1 }
				},
				"additionalProperties": false
			},
			"ConversationSnapshot": {
				"type": "object",
				"required": [
					"threadId",
					"tenantId",
					"ownerUserId",
					"revision",
					"messages",
					"trace"
				],
				"properties": {
					"threadId": { "type": "string" },
					"tenantId": { "type": "string" },
					"ownerUserId": { "type": "string" },
					"revision": { "type": "integer" },
					"messages": { "type": "array", "items": { "type": "object" } },
					"trace": { "type": "object" }
				},
				"additionalProperties": false
			},
			"ErrorBehavior": {
				"type": "object",
				"required": [
					"retryable",
					"financial_effect",
					"human_action",
					"agent_hint",
					"retry_after_s"
				],
				"properties": {
					"retryable": {
						"enum": [
							"never",
							"safe_if_idempotent",
							"conditional",
							"after_reconcile"
						]
					},
					"financial_effect": {
						"enum": ["none", "unknown", "possible_partial"]
					},
					"human_action": {
						"enum": ["none", "approve", "step_up", "contact_support"]
					},
					"agent_hint": {
						"enum": [
							"NONE",
							"FIX_AND_RETRY",
							"RETRY_WITH_BACKOFF",
							"REQUEST_HUMAN_APPROVAL",
							"REQUEST_STEP_UP",
							"WAIT_FOR_SETTLEMENT",
							"ABORT_AND_REPORT"
						]
					},
					"retry_after_s": {
						"type": ["integer", "null"],
						"minimum": 0
					}
				},
				"additionalProperties": false
			},
			"ErrorCorrelation": {
				"type": "object",
				"required": ["trace_id"],
				"properties": {
					"trace_id": {
						"type": "string"
					}
				},
				"additionalProperties": false
			},
			"HealthResponse": {
				"type": "object",
				"required": ["status", "service"],
				"properties": {
					"status": {
						"const": "ok"
					},
					"service": {
						"type": "string"
					}
				},
				"additionalProperties": false
			},
			"Item": {
				"type": "object",
				"required": ["id", "name", "metadata", "created_at"],
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"name": {
						"type": "string"
					},
					"metadata": {
						"type": "object",
						"additionalProperties": true
					},
					"created_at": {
						"type": "string",
						"format": "date-time"
					}
				},
				"additionalProperties": false
			},
			"SessionCreated": {
				"type": "object",
				"required": ["status"],
				"properties": { "status": { "const": "created" } },
				"additionalProperties": false
			},
			"TransactionEvidence": {
				"type": "object",
				"required": [
					"transactionId",
					"status",
					"amountBucket",
					"currency",
					"provenance",
					"version"
				],
				"properties": {
					"transactionId": { "type": "string" },
					"status": { "enum": ["approved", "declined", "pending", "reversed"] },
					"amountBucket": { "enum": ["low", "medium", "high"] },
					"currency": { "type": "string", "minLength": 3, "maxLength": 3 },
					"provenance": { "const": "synthetic_local_fixture" },
					"version": { "const": "dispute-demo-v1" }
				},
				"additionalProperties": false
			},
			"DisputeEvidence": {
				"type": "object",
				"required": [
					"disputeId",
					"transactionId",
					"status",
					"priority",
					"provenance",
					"version"
				],
				"properties": {
					"disputeId": { "type": "string" },
					"transactionId": { "type": "string" },
					"status": { "enum": ["open", "under_review", "escalated", "closed"] },
					"priority": { "enum": ["normal", "high"] },
					"provenance": { "const": "synthetic_local_fixture" },
					"version": { "const": "dispute-demo-v1" }
				},
				"additionalProperties": false
			},
			"DisputeCase": {
				"type": "object",
				"required": [
					"caseId",
					"disputeId",
					"status",
					"createdAt",
					"updatedAt",
					"provenance",
					"version"
				],
				"properties": {
					"caseId": { "type": "string" },
					"disputeId": { "type": "string" },
					"status": {
						"enum": ["open", "pending_approval", "escalated", "denied"]
					},
					"createdAt": { "type": "string", "format": "date-time" },
					"updatedAt": { "type": "string", "format": "date-time" },
					"provenance": { "const": "synthetic_local_fixture" },
					"version": { "const": "dispute-demo-v1" }
				},
				"additionalProperties": false
			},
			"EscalationRequest": {
				"type": "object",
				"required": ["reasonCode"],
				"properties": {
					"reasonCode": {
						"enum": [
							"unrecognized_transaction",
							"transaction_declined",
							"other"
						]
					}
				},
				"additionalProperties": false
			},
			"ApprovalDecision": {
				"type": "object",
				"required": ["decision"],
				"properties": { "decision": { "enum": ["approved", "rejected"] } },
				"additionalProperties": false
			},
			"PendingEscalation": {
				"type": "object",
				"required": ["approvalId", "case"],
				"properties": {
					"approvalId": { "type": "string" },
					"case": { "type": "object" }
				},
				"additionalProperties": false
			},
			"MockEscalationDecision": {
				"type": "object",
				"required": ["case", "action"],
				"properties": {
					"case": { "type": "object" },
					"action": { "type": ["object", "null"] }
				},
				"additionalProperties": false
			},
			"ReadinessResponse": {
				"type": "object",
				"required": ["status", "service", "details"],
				"properties": {
					"status": {
						"enum": ["ok", "degraded"]
					},
					"service": {
						"type": "string"
					},
					"details": {
						"type": "object",
						"additionalProperties": true
					}
				},
				"additionalProperties": false
			}
		}
	}
}
