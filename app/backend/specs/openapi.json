							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionCreated"
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid identity token",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"502": {
						"description": "Identity runtime unavailable",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
