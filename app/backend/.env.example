APP_NAME=base-bun-typescript-service
APP_ENV=dev
CONFIG_FILE=config/settings.toml
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_ENABLED=false
BUCKET_ENABLED=false
CACHE_ENABLED=false
SERVICE_TOKEN=

# Browser auth and server-side session (never expose these to the LLM/Jev)
SESSION_COOKIE_NAME=__Host-session
SESSION_STORE_ENABLED=false
KV_PROVIDER=valkey
KV_URL=
KV_USERNAME=
KV_PASSWORD=
KV_TLS=true
KV_KEY_PREFIX=agent:
SESSION_TTL_SECONDS=1800
HANDLE_TTL_SECONDS=300
# Exact-match LLM response cache on the same Memorystore (namespace llm:resp:v1:).
# Off by default; requires KV_URL. Never stores raw prompts or evidence rows.
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=600
# Base64url-encoded 32-byte key, supplied by a secret manager.
PRIVATE_DATA_ENCRYPTION_KEY=
CSRF_SECRET=
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Google Cloud data stores
DATABASE_URL=
DATABASE_READONLY_URL=
FIRESTORE_ENABLED=false
BIGQUERY_ENABLED=false
# BIGQUERY_ENABLED=true requires an explicit dataset and location.
BIGQUERY_DATASET=
BIGQUERY_JOB_TIMEOUT_MS=30000
# Sanitized evaluation results (ADR 0015). Empty dataset = no persistence. It
# needs BIGQUERY_ENABLED=true and must differ from BIGQUERY_DATASET.
BIGQUERY_EVAL_DATASET=
BIGQUERY_EVAL_TABLE=evaluation_results
STRUCTURED_CATALOG_PATH=config/structured-catalog.json
GCS_ENABLED=false
# Private KG artifact bucket (Terraform injects GCS_GRAPH_BUCKET from kg_artifacts).
GCS_GRAPH_BUCKET=
# Must match pipeline --gcs-prefix (empty → {tenant}/current.json).
GCS_GRAPH_ARTIFACT_PREFIX=
GCS_GRAPH_TENANT_ID=demo-bankai
# Development-only immutable-file adapter for a locally published KG artifact.
# It is rejected in prod and only permits the synthetic demo tenant.
KG_RAG_LOCAL_ENABLED=false
KG_RAG_LOCAL_ARTIFACT_DIR=.local/kg-rag
KG_RAG_LOCAL_TENANT_ID=demo-bankai
CHAT_ENABLED=false
AGENTIC_CHAT_ENABLED=false
# Process-level comparative runner. `baseline` is deliberately ungated and
# never selected by a browser request. It uses Vertex native function calling
# and a bounded, session-scoped QueryPlan tool only for comparative experiments.
CHAT_PIPELINE=demo
BASELINE_CHAT_ENABLED=false
BASELINE_QUERY_CATALOG_PATH=config/structured-catalog.example.json
BASELINE_MAX_RETRIEVAL_ATTEMPTS=2
REALTIME_ENABLED=false
DEMO_AUTH_ENABLED=false
DEMO_ACTOR_HMAC_KEY=
GCS_UPLOAD_BUCKET=
GCS_UPLOAD_PREFIX=conversation-uploads/
CHAT_MAX_ATTACHMENT_BYTES=10485760
CHAT_MAX_ATTACHMENTS=3

# Google Cloud / Model Armor / Sensitive Data Protection
# Server-to-server Google auth uses ADC/IAM; do not put a Google API key here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_INSPECT_TEMPLATE=
MODEL_ARMOR_DEIDENTIFY_TEMPLATE=
SDP_INSPECT_TEMPLATE=
SDP_DEIDENTIFY_TEMPLATE=
VERTEX_AI_ENABLED=false
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=
VERTEX_AI_MODEL=
VERTEX_AI_API_ENDPOINT=

# Optional providers (enable only after their adapter and policy are ready)
JEV_ENABLED=false
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=
JEV_MIN_CONFIDENCE=0.7
JEV_TIMEOUT_MS=10000
OPENAI_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_ENABLED=false
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional local PII detector and observability
LOCAL_PII_DETECTOR_ENABLED=false
LOCAL_PII_DETECTOR_URL=
LOCAL_PII_DETECTOR_API_KEY=
# Spans go only to Langfuse Cloud US (no arbitrary OTLP endpoint). OTEL_ENABLED
# and LANGFUSE_ENABLED must be set together; enabling them requires both keys
# and TELEMETRY_CORRELATOR_KEY (>= 16 chars, secret manager / local .env only).
# Do not set OTEL_EXPORTER_OTLP_*: telemetry startup refuses them.
OTEL_ENABLED=false
TELEMETRY_CORRELATOR_KEY=
# Langfuse Cloud US visualizes allowlisted OTel metadata only (ADR 0012/0015).
# Do not self-host Langfuse Docker for P0. Supply keys via secret manager /
# local .env — never commit them. Nothing is sent unless both flags are true.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# HTTP and agent guardrails
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY=
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_PER_MINUTE=60
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_RETRIES_PER_NODE=2
AGENT_MAX_WALL_TIME_MS=30000
AGENT_MAX_RETRIEVED_CHUNKS=8
AGENT_MAX_INPUT_TOKENS=0
AGENT_MAX_OUTPUT_TOKENS=0
