{
	"name": "base-bun-typescript-service",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check .",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"dev": "bun --watch src/index.ts",
		"format": "biome format --write .",
		"agent:matrix": "bun scripts/agent-matrix.ts",
		"spec:check": "bun run scripts/validate-openapi.ts",
		"start": "bun src/index.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.1.0",
		"@fastify/websocket": "^11.2.0",
		"@google-cloud/bigquery": "^9.1.0",
		"@google-cloud/firestore": "^7.11.0",
		"@google-cloud/storage": "^7.15.2",
		"@langchain/core": "^1.1.48",
		"@langchain/langgraph": "^1.4.18",
		"@opentelemetry/api": "^1.9.1",
		"@scalar/fastify-api-reference": "^1.67.0",
		"fastify": "^5.12.1",
		"redis": "^5.8.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4.0",
		"@types/ws": "^8.5.13",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0"
}
